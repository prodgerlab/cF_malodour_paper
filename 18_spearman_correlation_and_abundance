# required packages
library(dplyr)
library(ggplot2)
library(stringr)
library(scales)

# target metabolite name (adjust if your exact string differs)
target <- "Methylamine, N,N-dimethyl-"

# prepare data, coerce types and add a row id
tmp <- merged_long %>%
  mutate(
    concentration = as.numeric(as.character(concentration)),  # safe coercion from factor/char
    metabolite = as.character(metabolite),
    metabolite_clean = str_trim(metabolite)   # remove leading/trailing whitespace
  ) %>%
  mutate(.row = row_number())

# identify the single row (first) with the max concentration for the target metabolite
row_to_remove <- tmp %>%
  filter(metabolite_clean == target & !is.na(concentration)) %>%
  slice_max(concentration, n = 1, with_ties = FALSE) %>%
  pull(.row)

# remove it (or warn if no matching non-NA value was found)
if (length(row_to_remove) == 0) {
  warning(paste0("No non-NA match found for metabolite: '", target, "'. No rows removed."))
  filtered_long <- tmp %>% select(-.row, -metabolite_clean)
} else {
  filtered_long <- tmp %>%
    filter(!(.row %in% row_to_remove)) %>%
    select(-.row, -metabolite_clean)
}

# plot using filtered data
ggplot(filtered_long, aes(x = symptom_status, y = concentration, fill = symptom_status)) +
  geom_boxplot(outlier.shape = NA, alpha = 0.8) +
