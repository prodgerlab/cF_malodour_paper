load("head_untar.RData")
load("liq_untar.RData")

###################################################
##
## ClEAN AND SCALE DATA FOR SPEARMAN'S CORRELATION
##
###################################################


microbiome_count <- microbiome
rownames(microbiome_count) <- microbiome_count$sampleID
microbiome_count <- microbiome_count[ , -c(1:2)]

# Eliminate columns (taxa) with zeros
microbiome_count <- microbiome_count[, colSums(microbiome_count, na.rm = TRUE) > 0, drop = FALSE]

# Eliminate rows (samples) with zeros
microbiome_count <- microbiome_count[rowSums(microbiome_count, na.rm = TRUE) > 0, , drop = FALSE]

# Calculate relative abundances
totals <- rowSums(microbiome_count, na.rm = TRUE)
microbiome_abund <- sweep(microbiome_count, 1, totals, "/")

# Confirm row sums are 1
rowSums(microbiome_abund)

#create targeted metabolite dataframe
rownames(liquid_target_met) <- liquid_target_met[[1]]
lt <- liquid_target_met[,-c(1:2)]

rownames(TMA) <- TMA[[1]]
TMA_fil <- TMA[,-c(1)]

# merge metabolites

mets <- merge(lt, TMA_fil, by = "row.names", all = FALSE)
rownames(mets) <- mets$Row.names
mets <- mets[ , -1]
mets <- mets[ , !(colnames(mets) %in% "symptom_status")]

# clean microbiome data to only include common rownames

common_ids <- intersect(rownames(mets), rownames(microbiome_abund))

mets <- mets[common_ids, , drop = FALSE]
mets <- mets[, !(names(mets) %in% "symptom_status")]
microbiome_abund <- microbiome_abund[common_ids, , drop = FALSE]

# get top 50 taxa
prev_vec <- colMeans(microbiome_abund > 0)
top30_taxa <- names(sort(prev_vec, decreasing = TRUE))[1:50]
microbiome_abund_top30 <- microbiome_abund[, top30_taxa]

# merge to one dataframe

micro_met <- merge(mets, microbiome_abund_top30)
rownames(micro_met) <- micro_met$Row.names
micro_met$Row.names <- NULL

#z-scale data 
micro_met <- as.data.frame(scale(micro_met))
                           
#########################################################
##
## SPLIT MICRO_MET INTO MICROBIOME AND METABOLITE SUBSETS
##
#########################################################
microbiome_scaled <- micro_met[, colnames(micro_met) %in% colnames(microbiome_abund_top30)]
mets_scaled <- micro_met[, colnames(micro_met) %in% colnames(mets)]

micro_names <- colnames(microbiome_scaled)
met_names <- colnames(mets_scaled)

#########################################################
##
## GENERATE MICROBIOME AND SPEARMAN'S CORRELATION MATRIX 
##
#########################################################

cormat <- cor(micro_met, method = "spearman", use = "pairwise.complete.obs")

# Microbe–microbe correlation matrix
cormat_micro <- cormat[micro_names, micro_names, drop = FALSE]


# Cluster the top 50 taxa into 5 clusters
dist_mat <- dist(cormat_micro)
hc <- hclust(dist_mat, method = "ward.D2")
taxa_clusters <- cutree(hc, k = 5)


# Reorder correlation matrix by clusters

taxa_order <- names(sort(taxa_clusters))
cormat_micro_ordered <- cormat_micro[taxa_order, taxa_order]

# Melt for ggplot
melted_cormat_micro <- melt(as.matrix(cormat_micro_ordered), na.rm = TRUE) %>%
  mutate(value = round(value, 2),
         Var1 = factor(Var1, levels = taxa_order),
         Var2 = factor(Var2, levels = rev(taxa_order)))  # reverse y-axis for proper orientation


# Compute cluster boundaries
cluster_sizes <- table(taxa_clusters[taxa_order])
cluster_cumsum <- cumsum(cluster_sizes)

n_taxa <- length(taxa_order)
hline_positions <- cluster_cumsum + 0.5              # horizontal lines
vline_positions <- n_taxa - rev(cluster_cumsum) + 0.5 # vertical lines (reversed for x-axis)

# Plot heatmap with cluster boundaries
ggheatmap_micro <- ggplot(melted_cormat_micro,
                          aes(x = Var2, y = Var1, fill = value)) +
  geom_tile(color = "white") +
  scale_fill_gradient2(low = "#383da0", high = "#d32b07", mid = "white",
                       midpoint = 0, limit = c(-1,1),
                       name = "Spearman\nCorrelation") +
  theme_minimal() +
  theme(axis.text.x = element_text(angle = 45, vjust = 1, size = 11, hjust = 1),
        axis.text.y = element_text(size = 11, hjust = 1)) +
  labs(x = NULL, y = NULL) +
  coord_fixed() +
  theme(panel.grid.major = element_blank(),
        panel.border = element_blank(),
        panel.background = element_blank(),
        axis.ticks = element_blank()) +
  # Add cluster boundary lines
  geom_hline(yintercept = hline_positions, color = "black", size = 0.6) +
  geom_vline(xintercept = vline_positions, color = "black", size = 0.6)

# Display heatmap
ggheatmap_micro

#############################################
##
## GENERATE TABLE OF MICROBIOME CORRELATIONS 
##
#############################################

# Use the relative-abundance top taxa 
taxa_df <- as.data.frame(microbiome_abund_top30)

# Prepare combinations of taxa (unique pairs: A-B where A < B)
taxa_names <- colnames(taxa_df)
pairs <- combn(taxa_names, 2, simplify = FALSE)

# Initialize results list
res_list <- vector("list", length(pairs))

# Loop through pairs and run cor.test (Spearman)
for (i in seq_along(pairs)) {
  pair <- pairs[[i]]
  x <- taxa_df[[ pair[1] ]]
  y <- taxa_df[[ pair[2] ]]
  # Use exact = FALSE for larger sample sizes to avoid warnings
  ct <- suppressWarnings(cor.test(x, y, method = "spearman", exact = FALSE))
  res_list[[i]] <- data.frame(
    Taxon_1 = pair[1],
    Taxon_2 = pair[2],
    Spearman_rho = as.numeric(ct$estimate),
    P_value = as.numeric(ct$p.value),
    stringsAsFactors = FALSE
  )
}

# Combine and adjust p-values (FDR BH)
spearman_results <- do.call(rbind, res_list)
spearman_results$FDR_adjusted_P <- p.adjust(spearman_results$P_value, method = "BH")

# Format numbers for presentation
spearman_results <- spearman_results %>%
  mutate(
    Spearman_rho = round(Spearman_rho, 3),
    P_value = signif(P_value, 3),
    FDR_adjusted_P = signif(FDR_adjusted_P, 3)
  ) %>%
  arrange(as.numeric(FDR_adjusted_P))

# View top lines
print(head(spearman_results, 12))

# Save CSV (publication-ready)
write.csv(spearman_results,
          file = "microbe_microbe_spearman_FDR.csv",
          row.names = FALSE)

# Optional: also save a filtered table of significant correlations (FDR < 0.05)
sig_results <- spearman_results %>%
  filter(as.numeric(FDR_adjusted_P) < 0.05)

if (nrow(sig_results) > 0) {
  write.csv(sig_results, "microbe_microbe_spearman_FDR_significant.csv", row.names = FALSE)
  gtsave(sig_results %>% gt(), "microbe_microbe_spearman_FDR_significant.html")
}


