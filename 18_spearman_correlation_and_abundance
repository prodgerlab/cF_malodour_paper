##############################################################
##
## TARGETED METABOLOMICS HEATMAP WITH SIGNIFICANCE STARS
##
##############################################################

# scale microbiome data
microbiome_scaled <- scale(microbiome_abund_top30)   
mets_scaled <- mets[, apply(mets, 2, var) != 0]     
mets_scaled <- scale(mets_scaled)               


# Compute microbe–metabolite Spearman correlations
cormat_met <- cor(microbiome_scaled, mets_scaled,
                  method = "spearman", use = "pairwise.complete.obs")


# Compute p-values for each pair
pval_met <- matrix(NA,
                   nrow = ncol(microbiome_scaled),  
                   ncol = ncol(mets_scaled),        
                   dimnames = list(colnames(microbiome_scaled),
                                   colnames(mets_scaled)))

for(i in 1:ncol(microbiome_scaled)){
  for(j in 1:ncol(mets_scaled)){
    test <- cor.test(microbiome_scaled[, i], mets_scaled[, j], method = "spearman")
    pval_met[i, j] <- test$p.value
  }
}


# Order microbes by taxa cluster
taxa_order <- names(sort(taxa_clusters[colnames(microbiome_scaled)]))
cormat_met <- cormat_met[taxa_order, , drop = FALSE]
pval_met <- pval_met[taxa_order, , drop = FALSE]


# Hierarchical clustering of metabolites 
col_dist <- dist(t(cormat_met))
col_hclust <- hclust(col_dist, method = "average")
col_order <- col_hclust$labels[col_hclust$order]

# Reorder columns
cormat_met <- cormat_met[, col_order, drop = FALSE]
pval_met <- pval_met[, col_order, drop = FALSE]


# Melt correlation + p-values for ggplot
melted_cormat_met <- melt(cormat_met, na.rm = TRUE) %>%
  mutate(Var1 = factor(Var1, levels = rownames(cormat_met)),
         Var2 = factor(Var2, levels = colnames(cormat_met)),
         value = as.numeric(value))

melted_pval_met <- melt(pval_met, na.rm = TRUE) %>%
  rename(pval = value)

melted_cormat_met <- left_join(melted_cormat_met, melted_pval_met, by = c("Var1","Var2"))

# Add significance stars
melted_cormat_met <- melted_cormat_met %>%
  mutate(stars = case_when(
    pval <= 0.001 ~ "***",
    pval <= 0.01  ~ "**",
    pval <= 0.05  ~ "*",
    TRUE ~ ""
  ))

# Plot heatmap with stars
ggheatmap_met <- ggplot(melted_cormat_met, aes(x = Var2, y = Var1, fill = value)) +
  geom_tile(color = "white") +
  geom_text(aes(label = stars), color = "black", size = 4) +
  scale_fill_gradient2(low = "darkgreen", high = "purple", mid = "white",
                       midpoint = 0, limit = c(-1, 1),
                       name = "Spearman\nCorrelation") +
  theme_minimal() +
  theme(axis.text.x = element_text(angle = 45, vjust = 1, size = 10, hjust = 1),
        axis.text.y = element_text(size = 11, hjust = 1)) +
  labs(x = "Metabolites (clustered)", y = "Top 50 Bacteria (clustered)") +
  coord_fixed() +
  theme(panel.grid.major = element_blank(),
        panel.border = element_blank(),
        panel.background = element_blank(),
        axis.ticks = element_blank())


