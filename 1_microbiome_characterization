# prepare data
taxa_cols <- colnames(microbiome)[!(colnames(microbiome) %in% c("sampleID", "symptom_status"))]
microbe_abund <- microbiome[, taxa_cols]
groups <- microbiome$symptom_status

# Manually compute matrix
bray_dist <- function(mat) {
  n <- nrow(mat)
  dist_mat <- matrix(0, n, n)
  for (i in 1:(n - 1)) {
    for (j in (i + 1):n) {
      num <- 2 * sum(pmin(mat[i, ], mat[j, ]))
      denom <- sum(mat[i, ] + mat[j, ])
      dist_mat[i, j] <- 1 - (num / denom)
      dist_mat[j, i] <- dist_mat[i, j]
    }
  }
  rownames(dist_mat) <- rownames(mat)
  colnames(dist_mat) <- rownames(mat)
  return(dist_mat)
}

bray_mat <- bray_dist(as.matrix(microbe_abund))

# compute mean between and within groups
mean_within_group <- function(group_label) {
  idx <- which(groups == group_label)
  vals <- bray_mat[idx, idx][upper.tri(bray_mat[idx, idx])]
  mean(vals, na.rm = TRUE)
}

mean_between_groups <- function(group1, group2) {
  idx1 <- which(groups == group1)
  idx2 <- which(groups == group2)
  mean(bray_mat[idx1, idx2], na.rm = TRUE)
}

# calculate results
mean_within_A <- mean_within_group("A")
mean_within_S <- mean_within_group("S")
mean_between_AS <- mean_between_groups("A", "S")

# print results 
cat("Average within-group Bray–Curtis (A):", mean_within_A, "\n")
cat("Average within-group Bray–Curtis (S):", mean_within_S, "\n")
cat("Average between-group Bray–Curtis (A vs S):", mean_between_AS, "\n")

