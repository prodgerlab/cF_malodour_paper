# bray-curtis distance function
bray_dist <- function(mat) {
  n <- nrow(mat)
  dist_mat <- matrix(0, n, n)
  for (i in 1:(n - 1)) {
    for (j in (i + 1):n) {
      num <- 2 * sum(pmin(mat[i, ], mat[j, ]))
      denom <- sum(mat[i, ] + mat[j, ])
      dist_mat[i, j] <- 1 - (num / denom)
      dist_mat[j, i] <- dist_mat[i, j]
    }
  }
  rownames(dist_mat) <- rownames(mat)
  colnames(dist_mat) <- rownames(mat)
  return(as.dist(dist_mat))
}

# prepare data
taxa_cols <- colnames(microbiome)[!(colnames(microbiome) %in% c("sampleID", "symptom_status"))]
microbe_abund <- as.matrix(microbiome[, taxa_cols])
groups <- as.factor(microbiome$symptom_status)

# compute bray-curtis distances
bray_d <- bray_dist(microbe_abund)
D <- as.matrix(bray_d)

# conduce PERMANOVA-like test
set.seed(123)
n_perm <- 999

# Compute total sum of squares and group sum of squares
overall_mean <- mean(D[upper.tri(D)])
group_means <- tapply(1:length(groups), groups, function(idx) mean(D[idx, idx][upper.tri(D[idx, idx])]))
ss_between <- sum(sapply(levels(groups), function(g) {
  n_g <- sum(groups == g)
  (n_g * (group_means[g] - overall_mean)^2)
}))
ss_total <- sum((D[upper.tri(D)] - overall_mean)^2)
R2_obs <- ss_between / ss_total

# Permutation test
perm_R2 <- replicate(n_perm, {
  perm_groups <- sample(groups)
  perm_group_means <- tapply(1:length(perm_groups), perm_groups, function(idx) mean(D[idx, idx][upper.tri(D[idx, idx])]))
  ssb <- sum(sapply(levels(groups), function(g) {
    n_g <- sum(perm_groups == g)
    (n_g * (perm_group_means[g] - overall_mean)^2)
  }))
  ssb / ss_total
})

p_value <- (sum(perm_R2 >= R2_obs) + 1) / (n_perm + 1)

cat("Observed R²:", round(R2_obs, 4), "\n")
cat("PERMANOVA p-value:", p_value, "\n")

